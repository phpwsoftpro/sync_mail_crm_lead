<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Bot Cứu Hộ (rescue_replies.py --apply): every 10 min, a genuine client reply that landed in
         the chatter (usually via Odoo fetchmail) while the ticket sits in a dormant stage
         (35/9/10/34/19) moves the ticket back to Reply Client. 48-hour window, junk/vendor filtered.
         Added 2026-09-15 after #462037 stayed in Send Email Done with a fresh VESLOG reply. -->
    <key>Label</key>
    <string>com.syncmail.rescue</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/trung/syncmail-repo-auto/venv/bin/python</string>
        <string>/Users/trung/syncmail-repo-auto/rescue_replies.py</string>
        <string>--apply</string>
        <string>--max-age-hours=48</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/trung/syncmail-repo-auto</string>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/trung/syncmail-repo-auto/logs/rescue_replies.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/trung/syncmail-repo-auto/logs/rescue_replies.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/Users/trung/.local/bin</string>
    </dict>
</dict>
</plist>
