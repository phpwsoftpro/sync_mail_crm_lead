<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- HTTP bridge (port 8765) so admin.wsoftpro.com can ask THE sender (send_reply_crm.py) to
         send one ticket immediately instead of waiting for the next 5-min --auto tick. admin_wsp
         never sends mail itself; this is the only way it reaches the sender. Token in
         syncmail-repo-auto/.env (SENDER_BRIDGE_TOKEN). Added 21/09/2026 (Fable). -->
    <key>Label</key>
    <string>com.syncmail.sender_bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/trung/syncmail-repo-auto/venv/bin/python</string>
        <string>/Users/trung/syncmail-repo-auto/sender_bridge.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/trung/syncmail-repo-auto</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/trung/syncmail-repo-auto/logs/sender_bridge.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/trung/syncmail-repo-auto/logs/sender_bridge.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/Users/trung/.local/bin</string>
    </dict>
</dict>
</plist>
